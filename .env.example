# ── Payment provider ──────────────────────────────────────────────────────
# mock      -> no credentials needed, deterministic fake payment rail (default)
# razorpay  -> real Razorpay TEST MODE (rzp_test_* keys, no real money moves)
PAYMENT_PROVIDER=mock

# Get free TEST MODE keys: log in to https://dashboard.razorpay.com/ ->
# toggle "Test Mode" (top left) -> Settings -> API Keys -> Generate Test Key.
# No business documents / KYC needed to use Test Mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Settings -> Webhooks -> create one pointing at
# https://<your-tunnel>/webhook/razorpay and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=

# ── Buyer agent ────────────────────────────────────────────────────────────
# rule_based -> deterministic planner, no LLM, no key needed (default)
# groq       -> real Llama-3.3-70B tool calling via Groq's free tier
AGENT_MODE=rule_based

# Get a free key: https://console.groq.com/keys (sign up with Google/GitHub,
# no card required). Free tier docs: https://console.groq.com/docs/rate-limits
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Misc ────────────────────────────────────────────────────────────────
# Base URL the backend is reachable at - used to build mock checkout links
# and the callback_url for real Razorpay Payment Links.
BACKEND_URL=http://127.0.0.1:8000
